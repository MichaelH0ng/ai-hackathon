# Copy this file to .env for local development. Never commit .env or real values.
# The fake student-bank data is committed and safe to share. Plaid keys are still

# Add your own key from https://platform.claude.com for photo reading and the financial assistant.
# The key remains on the server; the assistant sends connected-account context to Claude per question.
ANTHROPIC_API_KEY=

# Optional: your own Plaid Sandbox credentials from dashboard.plaid.com.
# Do not paste credentials into this file before committing it.
PLAID_CLIENT_ID=
# Use the secret that matches PLAID_ENV (sandbox or production).
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
PLAID_ENV=sandbox
# Optional: the name of a Link customization saved in the Plaid Dashboard (logo/colors/text).
PLAID_LINK_CUSTOMIZATION=
# Optional: where banks with their own login page send you back (https in Production),
# e.g. https://your-app.vercel.app/ . Add the same URL under Allowed redirect URIs in Plaid.
PLAID_REDIRECT_URI=
