ANTHROPIC_API_KEY=

# Optional: your own Plaid Sandbox credentials from dashboard.plaid.com.
# Do not paste credentials into this file before committing it.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
